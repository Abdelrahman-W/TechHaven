# Application Server Configuration
NODE_ENV=production
PORT=4000

# High-Security Cryptographic JWT Session Secret (Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-secure-64-character-jwt-secret-here

# Frontend API URL
VITE_API_URL=/api

# CORS: Allowed frontend origins (comma-separated, no trailing slashes)
# Development localhost origins are used automatically when NODE_ENV is not 'production'
# Production: set this to your actual deployed frontend domain(s)
# CORS_ORIGINS=https://egyhardware.vercel.app

# Paymob Gateway Credentials (from Paymob Dashboard)
PAYMOB_MODE=sandbox
PAYMOB_API_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=

# Cloud Database (Supabase) - Optional
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
